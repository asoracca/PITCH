{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beef-backend",
  "main": "backend/worker.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [{ "binding": "DB", "database_name": "beef-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "drizzle" }],
  "vars": { "CORS_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000" }
}

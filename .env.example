# Vercel: connect a Turso Free database. These are database credentials, not AI keys.
# Add them as server-only Vercel environment variables; never NEXT_PUBLIC_*.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
ENABLE_EXPERIMENTAL_COREPACK="1"
# The skeleton uses the API on the same origin. Extra exact origins are optional.
CORS_ORIGINS=""
# No OpenAI key is required or used by the Vercel prototype.
# Optional approved moderator account IDs, comma separated.
PITCH_MODERATOR_IDS=""
# Optional ICE servers; default is free STUN, with no relay.
VOICE_ICE_SERVERS=""
